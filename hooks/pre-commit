#!/bin/sh
# Prospera 並存 shim — pre-commit 只委派回各 repo 自身 .git/hooks/pre-commit，本身不做任何檢查。
#
# ★為何仍需要：global `core.hooksPath` 一設，git **完全忽略** 各 repo 的 .git/hooks/；
#   本 shim 令各 repo 原有 pre-commit（目錄結構檢查等）照跑。
#
# ★2026-09-18 L0 裁示：fleet 級提交前閘（全機簡體字檢查＋交付物檢查）已拆除，
#   本 shim 不再引用任何字形判準；字形檢查只保留在治理庫交付出口
#   `00_governance/delivery_exit/convert_and_check`。
#
# ★路徑取法：用 `git rev-parse --git-dir` 而非 `--git-path hooks/...`——
#   後者**會被 core.hooksPath 改寫**（實測），委派目標會指回本目錄造成無限遞迴。
#
# fail-open：無 git／無本地 hook → exit 0。
GITDIR="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
[ -z "$GITDIR" ] && exit 0

LOCAL="$GITDIR/hooks/pre-commit"
[ -x "$LOCAL" ] && exec "$LOCAL" "$@"
[ -f "$LOCAL" ] && exec sh "$LOCAL" "$@"
exit 0
